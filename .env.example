# Dominio ufficiale usato per canonical e indicizzazione.
SITE_URL=https://eventsstudio-demo.netlify.app
SITE_INDEXABLE=false

# Destinazione del solo servizio Netlify Forms: HTTPS, senza percorso.
# Se assente, si usa URL di Netlify e poi il dominio attuale del sito.
CONTACT_SITE_ORIGIN=https://eventsstudio-demo.netlify.app

# Interruttore di emergenza: false disattiva il modulo mantenendo email/telefono.
CONTACT_FORM_ENABLED=true

# Non sono necessari token Netlify o password email nel browser.
# Netlify Blobs riceve le credenziali dal runtime Netlify/OpenNext.
# Con next dev/start fuori da Netlify gli invii reali sono rifiutati (503).
